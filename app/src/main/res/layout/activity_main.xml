<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/budgetBackgroundColor"
    tools:context=".MainActivity">
    <!-- HOME HEADER-->
    <FrameLayout
        android:id="@+id/homeHeader"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="?attr/budgetPrimaryColor"
        android:layout_gravity="top"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home"
            android:textColor="?attr/budgetOnPrimaryColor"
            android:textSize="30sp"
            android:fontFamily="@font/outfit_bold"
            android:layout_gravity="center" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open_settings"
            android:padding="12dp"
            android:src="@drawable/ic_account"
            app:tint="?attr/budgetOnPrimaryColor" />
    </FrameLayout>

    <!-- SCROLLABLE PAGE LAYOUT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/homeHeader"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">
        <!--PAGE CONTENTS-->
        <LinearLayout
            android:id="@+id/pageContentsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- BALANCE OVERVIEW CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/budgetOverviewCard"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="?attr/budgetSurfaceColor"
                app:strokeWidth="2dp"
                app:strokeColor="?attr/budgetTextColor">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/imgBuddy"
                        android:layout_width="138dp"
                        android:layout_height="138dp"
                        app:srcCompat="@drawable/main_buddy"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="6dp"
                        android:contentDescription="@string/buddy"/>

                    <TextView
                        android:id="@+id/tvBuddyName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="3dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_bold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="?attr/budgetTextColor"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/imgBuddy"
                        app:layout_constraintStart_toStartOf="@id/imgBuddy"
                        app:layout_constraintTop_toBottomOf="@id/imgBuddy"
                        tools:text="Budster the Budgeter" />

                    <!--BALANCE TEXT-->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        app:layout_constraintStart_toEndOf="@id/imgBuddy"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="10dp">

                        <TextView
                            android:id="@+id/tvBalance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/net_cash_flow"
                            android:textSize="15sp"
                            android:textColor="?attr/budgetTextColor"
                            android:fontFamily="@font/roboto_bold" />

                        <TextView
                            android:id="@+id/tvBalanceAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="27sp"
                            android:textStyle="bold"
                            android:textColor="?attr/budgetTextColor"
                            android:fontFamily="@font/roboto_bold"/>

                        <TextView
                            android:id="@+id/tvIncome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/income"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/budgetTextColor"
                            android:fontFamily="@font/roboto_bold"/>

                        <TextView
                            android:id="@+id/tvIncomeAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/moss"
                            android:textSize="21sp"
                            android:fontFamily="@font/roboto_bold"/>

                        <TextView
                            android:id="@+id/tvExpenses"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/expenses"
                            android:textSize="15sp"
                            android:textColor="?attr/budgetTextColor"
                            android:fontFamily="@font/roboto_bold" />

                        <TextView
                            android:id="@+id/tvExpensesAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/cherry"
                            android:textSize="21sp"
                            android:fontFamily="@font/roboto_bold"/>
                    </LinearLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BUDGET SPENT CARD (expandable) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/budgetSpentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="15dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/budgetSurfaceColor"
                app:strokeWidth="2dp"
                app:strokeColor="?attr/budgetTextColor">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingBottom="20dp">

                    <!--HEADER & EXPAND/COLLAPSE BTN -->
                    <Button
                        android:id="@+id/btnBudgetSpentExpand"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        style="@style/CustomDefaultButton"
                        android:background="@drawable/rounded_teal_bg"
                        android:text="@string/budget_spent"
                        android:fontFamily="@font/outfit_bold"
                        android:textSize="25sp"
                        android:textColor="?attr/budgetOnPrimaryColor"
                        android:layout_marginBottom="5dp"
                        app:layout_constraintTop_toTopOf="parent"
                        android:drawableEnd="@drawable/ic_downward_arrow"
                        android:drawableTint="?attr/budgetOnPrimaryColor" />

                    <!-- Budget Spent Contents ALWAYS VISIBLE -->
                    <LinearLayout
                        android:id="@+id/visibleBudgetContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/btnBudgetSpentExpand">

                        <TextView
                            android:id="@+id/tvBudgetLimit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?attr/budgetTextColor"
                            android:textSize="15sp"
                            tools:text="Spending limit: $55.00" />

                        <TextView
                            android:id="@+id/tvBudgetSpent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:textSize="15sp"
                            android:textColor="?attr/budgetTextColor"/>

                        <TextView
                            android:id="@+id/tvBudgetIncome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="?attr/budgetTextColor"
                            android:textSize="15sp"
                            tools:text="Income: $500.00" />

                        <TextView
                            android:id="@+id/tvBudgetIncludedIncome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:textColor="?attr/budgetTextColor"
                            android:textSize="13sp"
                            android:visibility="gone"
                            tools:text="Included in limit: $500.00"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tvBudgetRemaining"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:textSize="15sp"
                            android:textColor="?attr/budgetTextColor"/>

                        <TextView
                            android:id="@+id/tvBudgetUsage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:textColor="?attr/budgetTextColor"
                            android:textSize="14sp"
                            tools:text="100% of spending limit used" />

                        <!-- Progress bar -->
                        <ProgressBar
                            android:id="@+id/pgBudgetBar"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_gravity="center_horizontal"
                            android:progressDrawable="@drawable/progress_bar"
                            android:layout_marginTop="10dp"/>

                    </LinearLayout>

                    <!-- expandable HIDDEN CONTENTS show expenditure, progress bar-->
                    <LinearLayout
                        android:id="@+id/hiddenBudgetContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_margin="20dp"
                        app:layout_constraintTop_toBottomOf="@+id/visibleBudgetContent">

                        <!-- BUDGET EXPENDITURE STUFF donut charts-->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvDonuts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RECORDS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/recordsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/budgetSurfaceColor"
                app:strokeWidth="2dp"
                app:strokeColor="?attr/budgetTextColor"
                android:layout_marginBottom="80dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp">
                    <!--HEADER-->
                    <Button
                        android:id="@+id/btnRecordsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        style="@style/CustomDefaultButton"
                        android:background="@drawable/rounded_teal_bg"
                        android:text="@string/records"
                        android:fontFamily="@font/outfit_bold"
                        android:textSize="25sp"
                        android:textColor="?attr/budgetOnPrimaryColor"
                        android:layout_marginBottom="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        android:drawableEnd="@drawable/ic_filter"
                        android:drawableTint="?attr/budgetOnPrimaryColor" />

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/recordsScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_constraintTop_toBottomOf="@+id/btnRecordsHeader"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:fillViewport="true">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRecords"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="vertical"
                            android:scrollbarStyle="insideInset"
                            app:layout_constraintTop_toBottomOf="@+id/btnRecordsHeader"/>
                    </androidx.core.widget.NestedScrollView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--NAVIGATION-->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavView"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="5dp"
        app:menu="@menu/navbar_menu"
        app:itemIconSize="30dp"
        app:itemIconTint="@drawable/nav_selector"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="unlabeled"
        app:itemPaddingTop="0dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
