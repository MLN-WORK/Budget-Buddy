<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/budgetBackgroundColor"
    tools:context=".BudgetActivity">

    <!-- PAGE HEADER-->
    <FrameLayout
        android:id="@+id/budgetHeader"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="?attr/budgetPrimaryColor"
        android:layout_gravity="top"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/budget"
            android:textColor="?attr/budgetOnPrimaryColor"
            android:textSize="30sp"
            android:fontFamily="@font/outfit_bold"
            android:layout_gravity="center" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingBottom="15dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/budgetHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomNavView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:id="@+id/scrollableContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!--MONTH CARD-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/monthSelectionCard"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginVertical="15dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/budgetSurfaceColor"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:strokeColor="?attr/budgetTextColor"
                app:strokeWidth="2dp">
                <!--MONTH TEXT & BUTTONS -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_back_arrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginStart="20dp"
                        android:backgroundTint="?attr/budgetSurfaceColor"
                        android:contentDescription="@string/previous_date"/>

                    <TextView
                        android:id="@+id/tvCurrentMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="25sp"
                        android:text="@string/month"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?attr/budgetTextColor"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageButton
                        android:id="@+id/btnForward"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_forward_arrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginEnd="20dp"
                        android:contentDescription="@string/next_month"
                        android:backgroundTint="?attr/budgetSurfaceColor" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--BUDGET OVERVIEW -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/budgetOverviewCard"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginVertical="15dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/budgetSurfaceColor"
                app:strokeWidth="2dp"
                app:strokeColor="?attr/budgetTextColor"
                app:layout_constraintTop_toBottomOf="@id/monthSelectionCard">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <!--HEADER-->
                    <TextView
                        android:id="@+id/tvOverview"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/rounded_teal_bg"
                        android:text="@string/budget_overview"
                        android:gravity="center_vertical"
                        android:textColor="?attr/budgetOnPrimaryColor"
                        android:textSize="25sp"
                        android:fontFamily="@font/outfit_bold"
                        android:paddingStart="20dp"
                        tools:ignore="RtlSymmetry"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <ImageView
                        android:id="@+id/imgBuddyBO"
                        android:contentDescription="@string/buddy"
                        android:layout_width="105dp"
                        android:layout_height="105dp"
                        android:src="@drawable/content_buddy"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvOverview"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="24dp"/>

                    <TextView
                        android:id="@+id/tvMaximumBudgetLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/roboto_bold"
                        android:text="@string/maximum_monthly_budget"
                        android:textColor="?attr/budgetTextColor"
                        android:textSize="17sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imgBuddyBO"
                        app:layout_constraintTop_toBottomOf="@id/tvOverview" />

                    <LinearLayout
                        android:id="@+id/maximumBudgetInput"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imgBuddyBO"
                        app:layout_constraintTop_toBottomOf="@id/tvMaximumBudgetLabel">

                        <TextView
                            android:id="@+id/tvCurrency1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="@font/roboto_bold"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:text="@string/default_currency_symbol"
                            android:textColor="?attr/budgetTextColor"
                            android:textSize="20sp" />

                        <EditText
                            android:id="@+id/edtMaximumBudget"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/roboto_bold"
                            android:gravity="center_vertical|end"
                            android:hint="@string/no_money"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:includeFontPadding="false"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:padding="0dp"
                            android:selectAllOnFocus="true"
                            android:singleLine="true"
                            android:textColor="?attr/budgetTextColor"
                            android:textColorHint="?attr/budgetTextColor"
                            android:textSize="20sp"
                            tools:ignore="RtlSymmetry" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/total_budgeted"
                        android:textColor="?attr/budgetTextColor"
                        android:textSize="17sp"
                        android:fontFamily="@font/roboto_regular"
                        app:layout_constraintTop_toBottomOf="@id/maximumBudgetInput"
                        app:layout_constraintStart_toEndOf="@id/imgBuddyBO"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:gravity="end"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginTop="10dp"/>

                    <LinearLayout
                        android:id="@+id/totalBudgetAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/rounded_beige_bg"
                        android:backgroundTint="?attr/budgetBackgroundColor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvTotal"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="6dp"
                        android:padding="5dp"
                        android:paddingHorizontal="8dp">

                        <TextView
                            android:id="@+id/tvCurrency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="25sp"
                            android:textColor="?attr/budgetTextColor"
                            android:fontFamily="@font/roboto_bold"/>

                        <TextView
                            android:id="@+id/tvTotalBudgeted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="25sp"
                            android:textColor="?attr/budgetTextColor"
                            android:textColorHint="?attr/budgetTextColor"
                            android:fontFamily="@font/roboto_bold"
                            android:paddingStart="10dp"
                            android:paddingEnd="0dp"
                            android:hint="@string/no_money"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvUnallocatedPercentage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="end"
                        android:text="@string/budget_unallocated_not_available"
                        android:textColor="?attr/budgetTextColor"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imgBuddyBO"
                        app:layout_constraintTop_toBottomOf="@id/totalBudgetAmount" />

                    <TextView
                        android:id="@+id/tvBudgetWarning"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="end"
                        android:text="@string/budget_categories_exceed_maximum_preview"
                        android:textColor="@color/cherry"
                        android:textSize="13sp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imgBuddyBO"
                        app:layout_constraintTop_toBottomOf="@id/tvUnallocatedPercentage"
                        tools:visibility="visible" />

                    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                        android:id="@+id/fabSaveBudget"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:text="@string/save"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="?attr/budgetOnPrimaryColor"
                        app:iconTint="?attr/budgetOnPrimaryColor"
                        app:icon="@drawable/ic_cash_coins"
                        android:backgroundTint="?attr/budgetPrimaryColor"
                        android:padding="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="10dp"
                        app:layout_constraintEnd_toEndOf="@id/imgBuddyBO"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgBuddyBO"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--BUDGET CREATION CONTENTS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/budgetByCategoryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="15dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/budgetSurfaceColor"
                app:strokeWidth="2dp"
                app:strokeColor="?attr/budgetTextColor"
                app:layout_constraintTop_toBottomOf="@id/budgetOverviewCard">
                <!--contents-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!--HEADER-->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/rounded_teal_bg"
                        android:text="@string/budget_by_category"
                        android:gravity="center_vertical"
                        android:textColor="?attr/budgetOnPrimaryColor"
                        android:textSize="25sp"
                        android:fontFamily="@font/outfit_bold"
                        android:paddingStart="20dp"
                        tools:ignore="RtlSymmetry" />

                    <!--LIST OF CATEGORIES -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBudgetCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/budgetSurfaceColor"/>
                    <Button
                        android:id="@+id/btnAddCategory"
                        style="@style/CustomDefaultButton"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/rounded_beige_bottom_bg"
                        android:text="@string/add_category"
                        android:textColor="?attr/budgetTextColor"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_add_circle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--BOTTOM NAVIGATION-->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavView"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="5dp"
        app:menu="@menu/navbar_menu"
        app:itemIconSize="30dp"
        app:itemIconTint="@drawable/nav_selector"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="unlabeled"
        app:itemPaddingTop="0dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
