<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".BudgetActivity">

    <!-- PAGE HEADER-->
    <FrameLayout
        android:id="@+id/budgetHeader"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/teal"
        android:layout_gravity="top"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/budget"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:fontFamily="@font/outfit_bold"
            android:layout_gravity="center" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingBottom="15dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/budgetHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomNavView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:id="@+id/scrollableContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!--MONTH CARD-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/monthSelectionCard"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginVertical="15dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/beige"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:strokeColor="@color/black"
                app:strokeWidth="2dp">
                <!--MONTH TEXT & BUTTONS -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_back_arrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginStart="20dp"
                        android:backgroundTint="@color/beige"
                        android:contentDescription="@string/previous_date"/>

                    <TextView
                        android:id="@+id/tvCurrentMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="25sp"
                        android:text="@string/month"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/black"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageButton
                        android:id="@+id/btnForward"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_forward_arrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginEnd="20dp"
                        android:contentDescription="@string/next_month"
                        android:backgroundTint="@color/beige" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--BUDGET OVERVIEW -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/budgetOverviewCard"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginVertical="15dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/beige"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/monthSelectionCard">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <!--HEADER-->
                    <TextView
                        android:id="@+id/tvOverview"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/rounded_teal_bg"
                        android:text="@string/budget_overview"
                        android:gravity="center_vertical"
                        android:textColor="@color/white"
                        android:textSize="25sp"
                        android:fontFamily="@font/outfit_bold"
                        android:paddingStart="20dp"
                        tools:ignore="RtlSymmetry"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <ImageView
                        android:id="@+id/imgBuddyBO"
                        android:contentDescription="@string/buddy"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:src="@drawable/content_buddy"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvOverview"
                        android:layout_margin="20dp"/>
                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_budgeted"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:fontFamily="@font/roboto_regular"
                        app:layout_constraintTop_toBottomOf="@+id/tvOverview"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginVertical="15dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/rounded_beige_bg"
                        android:backgroundTint="@color/cream"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvTotal"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginVertical="10dp"
                        android:padding="5dp"
                        android:paddingHorizontal="8dp">

                        <TextView
                            android:id="@+id/tvCurrency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="30sp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/roboto_bold"/>

                        <TextView
                            android:id="@+id/tvTotalBudgeted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="30sp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:fontFamily="@font/roboto_bold"
                            android:paddingStart="10dp"
                            android:hint="@string/no_money"/>
                    </LinearLayout>

<!--                    <TextView-->
<!--                        android:id="@+id/tvTotalBudgeted"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="50dp"-->
<!--                        android:textAlignment="center"-->
<!--                        android:text="R0.00"-->
<!--                        android:textColor="@color/black"-->
<!--                        android:textSize="30sp"-->
<!--                        android:fontFamily="@font/roboto_bold"-->
<!--                        android:background="@drawable/rounded_beige_bg"-->
<!--                        android:backgroundTint="@color/cream"-->
<!--                        app:layout_constraintEnd_toEndOf="parent"-->
<!--                        app:layout_constraintTop_toBottomOf="@+id/tvTotal"-->
<!--                        android:layout_marginHorizontal="20dp"-->
<!--                        android:layout_marginVertical="10dp"-->
<!--                        android:paddingTop="5dp"-->
<!--                        android:paddingHorizontal="8dp"/>-->

                    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                        android:id="@+id/fabSaveBudget"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:text="@string/save"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/white"
                        app:iconTint="@color/white"
                        app:icon="@drawable/ic_cash_coins"
                        android:backgroundTint="@color/teal"
                        android:padding="1dp"
                        android:layout_marginVertical="10dp"
                        android:layout_marginHorizontal="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--BUDGET CREATION CONTENTS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/budgetByCategoryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="15dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/beige"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/budgetOverviewCard">
                <!--contents-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!--HEADER-->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/rounded_teal_bg"
                        android:text="@string/budget_by_category"
                        android:gravity="center_vertical"
                        android:textColor="@color/white"
                        android:textSize="25sp"
                        android:fontFamily="@font/outfit_bold"
                        android:paddingStart="20dp"
                        tools:ignore="RtlSymmetry" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingTop="5dp"
                        android:layout_marginBottom="5dp">
                        <TextView
                            android:layout_width="170dp"
                            android:layout_height="wrap_content"
                            android:text="@string/min_spending_goal"
                            android:textSize="18sp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/roboto_bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginVertical="10dp"/>

                        <LinearLayout
                            android:layout_width="140dp"
                            android:layout_height="50dp"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_input"
                            android:layout_marginHorizontal="15dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp">

                            <TextView
                                android:id="@+id/tvCurrency1"
                                android:layout_width="wrap_content"
                                android:layout_height="50dp"
                                android:textSize="20sp"
                                android:text="@string/default_currency_symbol"
                                android:textColor="@color/black"
                                android:fontFamily="@font/roboto_bold"
                                android:layout_marginVertical="2dp"
                                android:paddingVertical="10dp"/>

                            <EditText
                                android:id="@+id/edtMinimumGoal"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:textSize="20sp"
                                android:textColor="@color/black"
                                android:textColorHint="@color/black"
                                android:fontFamily="@font/roboto_bold"
                                android:paddingStart="5dp"
                                android:hint="@string/no_money"
                                tools:ignore="RtlSymmetry" />

                        </LinearLayout>

<!--                        <EditText-->
<!--                            android:id="@+id/edtMinimumGoal"-->
<!--                            android:layout_width="150dp"-->
<!--                            android:layout_height="50dp"-->
<!--                            android:background="@drawable/bg_input"-->
<!--                            android:hint="@string/no_money"-->
<!--                            android:textSize="20sp"-->
<!--                            android:fontFamily="@font/roboto_regular"-->
<!--                            android:textColor="@color/black"-->
<!--                            android:textColorHint="@color/black"-->
<!--                            android:paddingStart="15dp"-->
<!--                            android:layout_marginHorizontal="15dp"-->
<!--                            app:layout_constraintEnd_toEndOf="parent"-->
<!--                            app:layout_constraintTop_toTopOf="parent"/>-->
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--LIST OF CATEGORIES -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBudgetCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/beige"/>
                    <!--DIVIDER-->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/black" />
                    <Button
                        android:id="@+id/btnAddCategory"
                        style="@style/CustomDefaultButton"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/rounded_beige_bottom_bg"
                        android:text="@string/add_category"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:drawableLeft="@drawable/ic_add_circle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--BOTTOM NAVIGATION-->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavView"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="5dp"
        app:menu="@menu/navbar_menu"
        app:itemIconSize="30dp"
        app:itemIconTint="@drawable/nav_selector"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="unlabeled"
        app:itemPaddingTop="0dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
