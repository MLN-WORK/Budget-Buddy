<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".AddImageActivity">
    <!-- Top Banner -->
    <FrameLayout
        android:id="@+id/aiHeader"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/teal"
        android:layout_gravity="top"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/tvPgBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_image"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:fontFamily="@font/outfit_bold"
            android:layout_gravity="center" />
        <!-- Back Button -->
        <ImageView
            android:id="@+id/ivBackBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="11dp"
            app:srcCompat="@drawable/ic_back_arrow"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- Image Preview -->
    <ImageView
        android:id="@+id/ivImgPreview"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginVertical="30dp"
        app:layout_constraintTop_toBottomOf="@id/aiHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:srcCompat="@drawable/bg_input"
        android:layout_marginHorizontal="20dp"/>

    <LinearLayout
        android:id="@+id/ll_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="30dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivImgPreview">
        <!-- Open Camera Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/takePhotoCard"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="15dp"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="@color/beige"
            app:cardCornerRadius="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivImgPreview"
            app:strokeColor="@color/black"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnTakePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="1dp"
                    android:background="@drawable/rounded_beige_bg"
                    android:backgroundTint="@color/beige"
                    android:contentDescription="@string/take_a_photo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_camera" />

                <TextView
                    android:id="@+id/tvTakePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_regular"
                    android:text="@string/take_a_photo"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Open Gallery Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/uploadCard"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="15dp"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="@color/beige"
            app:cardCornerRadius="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivImgPreview"
            app:strokeColor="@color/black"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnOpenGallery"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="1dp"
                    android:background="@drawable/rounded_beige_bg"
                    android:backgroundTint="@color/beige"
                    android:contentDescription="@string/upload_from_gallery"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_gallery" />

                <TextView
                    android:id="@+id/tvUploadGallery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/outfit_regular"
                    android:text="@string/upload_from_gallery"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSaveImg"
        style="@style/CustomDefaultButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_button_teal"
        android:text="@string/save"
        android:textSize="24sp"
        android:textAlignment="center"
        android:layout_margin="20dp"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/ll_buttons"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>