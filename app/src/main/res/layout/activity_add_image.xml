<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/budgetBackgroundColor"
    tools:context=".AddImageActivity">

    <FrameLayout
        android:id="@+id/aiHeader"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="?attr/budgetPrimaryColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvPgBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/outfit_bold"
            android:text="@string/add_image"
            android:textColor="?attr/budgetOnPrimaryColor"
            android:textSize="30sp" />

        <ImageButton
            android:id="@+id/ivBackBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="?attr/budgetOnPrimaryColor" />
    </FrameLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/aiHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@drawable/bg_input">

                <ImageView
                    android:id="@+id/ivImgPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/receipt_preview"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    tools:srcCompat="@drawable/placeholder_image" />

                <ProgressBar
                    android:id="@+id/receiptProgress"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/ll_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/takePhotoCard"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/budgetSurfaceColor"
                    app:cardCornerRadius="20dp"
                    app:strokeColor="?attr/budgetTextColor"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btnTakePhoto"
                            android:layout_width="match_parent"
                            android:layout_height="86dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/take_a_photo"
                            android:padding="18dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_camera" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"
                            android:text="@string/take_a_photo"
                            android:textColor="?attr/budgetTextColor"
                            android:textSize="17sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/uploadCard"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/budgetSurfaceColor"
                    app:cardCornerRadius="20dp"
                    app:strokeColor="?attr/budgetTextColor"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btnOpenGallery"
                            android:layout_width="match_parent"
                            android:layout_height="86dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/upload_from_gallery"
                            android:padding="18dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_gallery" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"
                            android:text="@string/upload_from_gallery"
                            android:textColor="?attr/budgetTextColor"
                            android:textSize="17sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveImg"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_teal"
                android:fontFamily="@font/outfit_bold"
                android:gravity="center"
                android:text="@string/attach_receipt"
                android:textColor="?attr/budgetOnPrimaryColor"
                android:textSize="22sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
