<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/budgetBackgroundColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="48dp"
        android:paddingBottom="40dp">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="90dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

        <ImageView
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="22dp"
            android:contentDescription="@string/buddy"
            android:scaleType="fitCenter"
            android:src="@drawable/happy_buddy" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/outfit_bold"
            android:gravity="center"
            android:text="@string/default_buddy_introduction"
            android:textColor="?attr/budgetTextColor"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_bold"
            android:gravity="center"
            android:layout_marginTop="22dp"
            android:text="@string/welcome_title"
            android:textColor="?attr/budgetPrimaryColor"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:text="@string/welcome_message"
            android:textColor="?attr/budgetTextColor"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueOffline"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_button_teal"
            android:fontFamily="@font/outfit_bold"
            android:gravity="center"
            android:text="@string/continue_offline"
            android:textColor="?attr/budgetOnPrimaryColor"
            android:textSize="19sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:text="@string/offline_explanation"
            android:textColor="?attr/budgetTextColor"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
