<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/budgetBackgroundColor">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavView"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/budgetBackgroundColor">

            <!-- Top Banner -->
            <FrameLayout
                android:id="@+id/aiHeader"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="?attr/budgetPrimaryColor"
                android:layout_gravity="top"
                android:layout_marginBottom="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <TextView
                    android:id="@+id/tvPgBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/view_summaries"
                    android:textColor="?attr/budgetOnPrimaryColor"
                    android:textSize="30sp"
                    android:fontFamily="@font/outfit_bold"
                    android:layout_gravity="center" />
                <!-- Back Button -->
                <ImageButton
                    android:id="@+id/btnBackTHA"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|center_vertical"
                    android:src="@drawable/ic_back_arrow"
                    android:backgroundTint="?attr/budgetPrimaryColor"
                    app:tint="?attr/budgetOnPrimaryColor"
                    android:contentDescription="@string/back_to_home"/>

            </FrameLayout>

            <!-- Toggle Button -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleButtonGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_gravity="center_horizontal"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTransactionTog"
                    android:layout_width="165dp"
                    android:layout_height="58dp"
                    android:text="@string/by_transaction"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:backgroundTint="?attr/budgetPrimaryColor"
                    android:textColor="?attr/budgetOnPrimaryColor"
                    android:textSize="14sp"
                    android:textAlignment="center"
                    app:strokeColor="?attr/budgetTextColor"
                    android:fontFamily="@font/roboto_bold"
                    android:textStyle="bold"
                    app:strokeWidth="2dp"
                    app:cornerRadius="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCategoryTog"
                    android:layout_width="165dp"
                    android:layout_height="58dp"
                    android:text="@string/by_category"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="?attr/budgetPrimaryColor"
                    android:textSize="14sp"
                    android:textAlignment="center"
                    app:strokeColor="?attr/budgetTextColor"
                    android:fontFamily="@font/roboto_bold"
                    app:strokeWidth="2dp"
                    app:cornerRadius="12dp"/>

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Date Filters -->
            <LinearLayout
                android:layout_width="330dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="20dp"
                android:layout_gravity="center"
                android:weightSum="2">

                <TextView
                    android:id="@+id/tvStartDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:text="@string/start_date"
                    android:textAlignment="center"
                    android:textColor="?attr/budgetTextColor" />

                <TextView
                    android:id="@+id/tvEndDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:text="@string/end_date"
                    android:textAlignment="center"
                    android:textColor="?attr/budgetTextColor"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="330dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input">

                <!-- Radio Buttons -->
                <RadioGroup
                    android:id="@+id/rgTransactionFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_horizontal">

                    <RadioButton
                        android:id="@+id/rbAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/all"
                        android:textColor="?attr/budgetTextColor"
                        app:buttonTint="?attr/budgetPrimaryColor"
                        android:paddingEnd="10dp"/>

                    <RadioButton
                        android:id="@+id/rbIncomes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/incomes"
                        android:textColor="?attr/budgetTextColor"
                        app:buttonTint="?attr/budgetPrimaryColor"
                        android:paddingEnd="10dp"/>

                    <RadioButton
                        android:id="@+id/rbExpenses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/expenses"
                        android:textColor="?attr/budgetTextColor"
                        app:buttonTint="?attr/budgetPrimaryColor"/>

                    <RadioButton
                        android:id="@+id/rbOcr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:text="@string/ocr_filter"
                        android:textColor="?attr/budgetTextColor"
                        app:buttonTint="?attr/budgetPrimaryColor" />
                </RadioGroup>

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/outfit"
                android:gravity="center"
                android:text="@string/transaction_actions_hint"
                android:textColor="@color/grey"
                android:textSize="14sp" />

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:overScrollMode="never"
                android:layout_marginHorizontal="20dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Nav -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavView"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="5dp"
        app:itemIconSize="30dp"
        app:itemIconTint="@drawable/nav_selector"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/navbar_menu"
        app:itemPaddingTop="0dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
