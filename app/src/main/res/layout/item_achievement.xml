<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/achievement_item_bg"
    android:layout_marginBottom="15dp">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivAchievementIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/locked_badge"
            android:contentDescription="@string/achievement_badge" />

        <TextView
            android:id="@+id/tvAchievementTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/achievement_title"
            android:textColor="@color/black"
            android:fontFamily="@font/outfit_bold"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/ivExpandToggle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_downward_arrow"
            android:contentDescription="@string/expand_collapse_arrow" />
    </LinearLayout>

    <!-- Expanded Section -->
    <LinearLayout
        android:id="@+id/expandedLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/tvAchievementDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/achievement_description_placeholder"
            android:textColor="@color/black"
            android:fontFamily="@font/outfit_regular"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/pbAchievementProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatusBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/completed"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_status_banner"
            android:padding="6dp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
