<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".AddCategoryActivity">

    <!--HEADER-->
    <FrameLayout
        android:id="@+id/addCatHeader"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/teal"
        android:layout_gravity="top"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tvAddCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_category"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:fontFamily="@font/outfit_bold"
            android:layout_gravity="center" />
        <!-- Back Button -->
        <ImageView
            android:id="@+id/ivBackBtn"
            android:contentDescription="@string/back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            app:srcCompat="@drawable/ic_back_arrow"
            app:tint="@color/white" />
    </FrameLayout>


    <LinearLayout
        android:id="@+id/add_cat_ll"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintTop_toBottomOf="@+id/addCatHeader"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="80dp"
        android:layout_marginHorizontal="20dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivSelectedIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_add_circle"
            android:scaleType="fitCenter"
            android:background="@drawable/circle_bg"
            android:padding="15dp"
            android:contentDescription="@string/selected_icon"
            android:clickable="true"
            android:focusable="true" />

        <EditText
            android:id="@+id/edtCategoryName"
            android:layout_width="230dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:hint="@string/category_name"
            android:inputType="text"
            android:padding="15dp"
            android:fontFamily="@font/roboto_regular"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="39dp"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnSaveCategory"
        style="@style/CustomDefaultButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_button_teal"
        android:text="@string/save"
        android:textAlignment="center"
        android:layout_marginHorizontal="20dp"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/add_cat_ll"
        android:layout_marginVertical="40dp"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/categoryDisplayCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="10dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="250dp">
            <!--HEADER-->
            <TextView
                android:id="@+id/tvSelectCatHeader"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/rounded_teal_bg"
                android:text="@string/select_category_icon"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:fontFamily="@font/outfit_bold"
                android:paddingStart="20dp"
                tools:ignore="RtlSymmetry"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAllCategoryIcons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/plain_rect_bg"
                android:scrollbars="vertical"
                app:layout_constraintTop_toBottomOf="@+id/tvSelectCatHeader"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
