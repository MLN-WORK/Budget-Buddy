<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/budgetBackgroundColor"
    android:padding="14dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tutorialCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="0dp"
        app:cardBackgroundColor="?attr/budgetSurfaceColor"
        app:cardCornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="?attr/budgetTextColor"
        app:strokeWidth="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="28dp"
            android:paddingTop="72dp"
            android:paddingBottom="82dp">

            <ImageView
                android:id="@+id/imgTutorialBuddy"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@string/buddy"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@id/tvTutorialTitle"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="270dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTutorialTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/outfit_bold"
                android:gravity="center"
                android:textColor="?attr/budgetPrimaryColor"
                android:textSize="36sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgTutorialBuddy" />

            <TextView
                android:id="@+id/tvTutorialDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/outfit"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/budgetTextColor"
                android:textSize="21sp"
                app:layout_constraintBottom_toTopOf="@id/tvTutorialTapHint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTutorialTitle"
                app:layout_constraintVertical_bias="0" />

            <TextView
                android:id="@+id/tvTutorialTapHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/outfit_bold"
                android:gravity="center"
                android:text="@string/tutorial_start_hint"
                android:textColor="?attr/budgetTextColor"
                android:textSize="17sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <View
        android:id="@+id/btnTutorialNextZone"
        android:layout_width="48dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:contentDescription="@string/next_tutorial_screen"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTutorialNext"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/next_tutorial_screen"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:text="@string/tutorial_next_arrow"
        android:textColor="?attr/budgetOnPrimaryColor"
        android:textSize="34sp"
        app:backgroundTint="?attr/budgetPrimaryColor"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnTutorialSkip"
        style="@style/CustomDefaultButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_input"
        android:elevation="8dp"
        android:minWidth="136dp"
        android:text="@string/skip_tutorial"
        android:textColor="?attr/budgetPrimaryColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
