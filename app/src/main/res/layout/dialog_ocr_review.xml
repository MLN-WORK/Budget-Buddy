<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/budgetSurfaceColor"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvOcrReviewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit_bold"
        android:gravity="center"
        android:textColor="?attr/budgetPrimaryColor"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/tvOcrRecommendation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/outfit"
        android:gravity="center"
        android:textColor="?attr/budgetTextColor"
        android:textSize="16sp" />

    <TextView android:id="@+id/tvOcrMerchant" style="@style/OcrReviewValue" />
    <TextView android:id="@+id/tvOcrDate" style="@style/OcrReviewValue" />
    <TextView
        android:id="@+id/tvOcrMonthWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:fontFamily="@font/outfit_bold"
        android:padding="12dp"
        android:textColor="?attr/budgetTextColor"
        android:textSize="15sp"
        android:visibility="gone" />
    <TextView android:id="@+id/tvOcrTotal" style="@style/OcrReviewValue" />
    <TextView android:id="@+id/tvOcrCategory" style="@style/OcrReviewValue" />
    <TextView android:id="@+id/tvOcrItems" style="@style/OcrReviewValue" />

    <ImageView
        android:id="@+id/imgOcrBuddy"
        android:layout_width="120dp"
        android:layout_height="105dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/buddy_mood"
        android:scaleType="fitCenter"
        android:src="@drawable/happy_buddy" />

    <TextView
        android:id="@+id/tvOcrBudgetImpact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit_bold"
        android:gravity="center"
        android:textColor="?attr/budgetTextColor"
        android:textSize="14sp" />
</LinearLayout>
