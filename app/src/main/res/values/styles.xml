<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TransactionDetailHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/outfit_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/budgetPrimaryColor</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="TransactionDetailAmount" parent="TransactionDetailHeading">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">?attr/budgetTextColor</item>
        <item name="android:textSize">34sp</item>
    </style>
    <style name="TransactionDetailValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:fontFamily">@font/outfit_bold</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">?attr/budgetTextColor</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TransactionDetailBadge" parent="TransactionDetailValue">
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/budgetPrimaryColor</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
