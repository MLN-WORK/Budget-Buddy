<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 1st line: description / amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Description"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:textColor="@color/black"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 2nd line: date -->
    <TextView
        android:id="@+id/tvDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2025-04-30"
        android:textSize="14sp"
        android:textColor="@color/black" />

    <!-- Category -->
    <TextView
        android:id="@+id/tvCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Category ID"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:layout_marginTop="4dp" />

    <!-- Recurring indicator -->
    <TextView
        android:id="@+id/tvFrequency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Every Month"
        android:textSize="14sp"
        android:textColor="#555555"
        android:visibility="gone" />

    <!-- Start–end date range -->
    <TextView
        android:id="@+id/tvDateRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2025-01-01 – 2025-12-31"
        android:textSize="14sp"
        android:textColor="#555555"
        android:visibility="gone" />

    <!-- Transaction photo -->
    <ImageView
        android:id="@+id/ivPhoto"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- Placeholder for no image -->
    <LinearLayout
        android:id="@+id/imagePlaceholderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/placeholderImageView"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/ic_image_placeholder"
            android:contentDescription="@string/placeholder_image_description" />

        <TextView
            android:id="@+id/placeholderTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_image_available"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/black" />

</LinearLayout>
